# Backend .env.example
# Copy to backend/.env for local development or set these in your hosting provider.
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/yourdb
DB_NAME=mystnodes_monitor
NODEREAL_API_KEY=your_nodereal_api_key
EMERGENT_LLM_KEY=your_emergent_llm_key
MYSTNODES_REF_CODE=your_ref_code_optional
CORS_ORIGINS=https://your-frontend-domain.example.com,https://your-android-app-domain.example.com
